# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# This file is for the FRONT-END (Vite). AI keys are set in Supabase, not here.

VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# --- Edge Function secrets (set in Supabase Dashboard → Project Settings → Edge Functions / Vault) ---
# Do NOT put these in .env; they are used only by Supabase Edge Functions.
#
#   LOVABLE_API_KEY  - auto-injected when Lovable Cloud is enabled for this project (no manual setup)
#   ALLOWED_ORIGIN   - e.g. http://localhost:8080 or https://yourapp.com (optional)
#
# See docs/AI_INTEGRATION_SETUP.md for step-by-step instructions.
